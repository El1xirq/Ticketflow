DATABASE_URL=postgresql+asyncpg://postgres:change-me@identity-db:5432/identity-service
SYNC_DATABASE_URL=postgresql://postgres:change-me@identity-db:5432/identity-service
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me@identity-db:5432/identity-service_test_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identity-service

ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=True

JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
